# Application
# Required in production: at least 32 characters and not an example value.
SECRET_KEY=your-secret-key-here
ENVIRONMENT=development  # development, production, test
DEBUG=false
LOG_LEVEL=INFO

# Network
HOST=0.0.0.0
PORT=8000
# Reverse proxy addresses uvicorn accepts forwarded headers from. Read by the
# application entry point, so the container command cannot drift from it.
FORWARDED_ALLOW_IPS=127.0.0.1

# CORS. Accepts a comma separated list or a JSON array.
# This is the only origin setting the CORS middleware reads.
CLIENT_ORIGIN=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Host header allowlist. A JSON array is also accepted.
# Required in production, where an empty value or '*' makes startup fail
# instead of silently disabling the host check.
ALLOWED_HOSTS=localhost,127.0.0.1

# External Services
AUTH_SERVER_URL=http://auth-server:8001
# Base path of the user management API on the auth server. The admin user
# endpoints proxy to AUTH_SERVER_URL + this path. The default works with the
# current Bidar deployment; override it only if that router moves.
AUTH_SERVER_USERS_PATH=/users
# Required in production.
DATABASE_URL=postgresql://user:password@postgres:5432/bngdrasil

# Proxy. The gateway is a buffered proxy, so request bodies are capped.
MAX_REQUEST_BODY_BYTES=10485760
PROXY_TIMEOUT_SECONDS=30
PROXY_MAX_CONNECTIONS=100
# Upstream paths that are never proxied. An entry blocks that path and every
# path below it, and the gateway answers 404. Upstream Prometheus endpoints
# are scraped from the internal network, so they must not be published here.
# An empty or blank value keeps the default; use [] to turn the block list off.
PROXY_BLOCKED_UPSTREAM_PATHS=/metrics

# Destination policy for registered services. Comma separated or JSON array.
# Loopback, link-local and metadata destinations are always rejected.
# A blank value keeps the declared default and warns, for the same reason as
# the block list above; use [] to turn the policy off on purpose.
SERVICE_URL_ALLOWED_HOSTS=
SERVICE_URL_DENIED_HOSTS=

# Observability backends the admin summary endpoints read. Both are optional.
# They are internal monitoring addresses and are never proxied to clients.
# Without PROMETHEUS_URL the /admin/api/observability endpoints answer 501.
# Without ALERTMANAGER_URL the alert list is still returned, and the silenced
# and inhibited flags stay null instead of being guessed.
# On the VM2 monitoring network these are:
#   PROMETHEUS_URL=http://prometheus:9090
#   ALERTMANAGER_URL=http://alertmanager:9093
PROMETHEUS_URL=
ALERTMANAGER_URL=
# Budget for one call to a backend above. The admin console polls every 30
# seconds, so a slow backend has to fail fast.
OBSERVABILITY_QUERY_TIMEOUT_SECONDS=2.5

# Features
ENABLE_METRICS=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_EXEMPT_PATHS=/health,/ready,/metrics
